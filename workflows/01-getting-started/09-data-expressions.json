      "parameters": {
        "jsCode": "// Un objeto con objetos anidados y arrays, como el que devuelve una API.\nreturn [{ json: {\n  usuario: { nombre: 'Laura Gómez', email: 'laura@example.com', zona: 'America/Bogota' },\n  tareas: [\n    { titulo: 'Enviar informe', prioridad: 'alta', fecha_limite: '2026-11-18', hecha: false },\n    { titulo: 'Reservar vuelo', prioridad: 'media', fecha_limite: '2026-11-25', hecha: true },\n    { titulo: 'Comprar regalo', prioridad: 'baja', fecha_limite: '', hecha: false },\n  ],\n  etiquetas: ['personal', 'trabajo'],\n} }];"
      },
