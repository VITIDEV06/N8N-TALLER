      "id": "d0507d9c-e994-5cbb-8375-1c9104f1e937",
      "name": "Expresiones",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Valida cada tarea y la transforma en un item independiente.\nconst datos = $input.first().json;\nconst hoy = DateTime.fromISO(datos.hoy);\nconst resultado = [];\n\nfor (const tarea of datos.tareas) {\n  const errores = [];\n  if (!tarea.titulo || tarea.titulo.length < 3) errores.push('título demasiado corto');\n  if (!['alta', 'media', 'baja'].includes(tarea.prioridad)) errores.push('prioridad no válida');\n\n  let diasRestantes = null;\n  if (tarea.fecha_limite) {\n    const fecha = DateTime.fromISO(tarea.fecha_limite);\n    if (!fecha.isValid) errores.push('fecha no válida');\n    else diasRestantes = Math.round(fecha.diff(hoy, 'days').days);\n  }\n\n  resultado.push({ json: {\n    titulo: tarea.titulo,\n    prioridad: tarea.prioridad,\n    hecha: tarea.hecha,\n    diasRestantes,\n    vencida: diasRestantes !== null && diasRestantes < 0 && !tarea.hecha,\n    valida: errores.length === 0,\n    errores,\n    responsable: datos.nombre,\n  } });\n}\nreturn resultado;"
      },
      "id": "2856bf35-606f-56f1-aae3-130ffaa01ce3",
      "name": "Validar y transformar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
