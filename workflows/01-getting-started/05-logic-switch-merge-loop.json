      "name": "Recorrer en lotes de 2",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Se ejecuta una vez por cada lote de 2 items.\n// $runIndex indica el número de vuelta del bucle (empieza en 0).\nreturn $input.all().map((item) => ({\n  json: { ...item.json, lote: $runIndex + 1, procesadoEn: $now.toFormat('HH:mm:ss') },\n}));"
      },
      "id": "e8b4d827-976a-582e-89d4-a1eb35b22373",
      "name": "Procesar lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// La salida \"done\" del bucle entrega todos los items procesados.\nconst tareas = $input.all().map((item) => item.json);\nconst porPrioridad = {};\nfor (const t of tareas) porPrioridad[t.prioridad] = (porPrioridad[t.prioridad] || 0) + 1;\n\nreturn [{ json: {\n  totalTareas: tareas.length,\n  lotes: Math.max(...tareas.map((t) => t.lote)),\n  porPrioridad,\n  tareas,\n} }];"
      },
      "id": "dbbe224c-a9f9-5f1c-81a2-dac24c7ef87f",
