        "jsCode": "// Datos ficticios: una lista de tareas con distintas prioridades.\nconst tareas = [\n  { titulo: 'Preparar presentación trimestral', prioridad: 'alta' },\n  { titulo: 'Responder correo del proveedor', prioridad: 'media' },\n  { titulo: 'Ordenar escritorio', prioridad: 'baja' },\n  { titulo: 'Pagar factura de internet', prioridad: 'alta' },\n  { titulo: 'Leer capítulo 3 del libro', prioridad: 'baja' },\n  { titulo: 'Planificar menú semanal', prioridad: 'media' },\n];\nreturn tareas.map((t) => ({ json: t }));"
