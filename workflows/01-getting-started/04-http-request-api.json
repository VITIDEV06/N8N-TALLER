    {
      "parameters": {
        "jsCode": "// Recibe todas las tareas unidas y calcula un resumen.\nconst tareas = $input.all().map((item) => item.json);\nconst completadas = tareas.filter((t) => t.estado === 'completada').length;\nconst total = tareas.length;\n\nreturn [{ json: {\n  total,\n  completadas,\n  pendientes: total - completadas,\n  porcentajeCompletado: total ? Math.round((completadas / total) * 100) : 0,\n  primerasPendientes: tareas.filter((t) => t.estado === 'pendiente').slice(0, 3).map((t) => t.titulo),\n} }];"
      },
      "id": "46fcead9-929c-5feb-bc2e-0b9cea6a9949",
