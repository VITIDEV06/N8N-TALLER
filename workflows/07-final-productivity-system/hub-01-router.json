    },
    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Router del Personal Productivity Hub.\n// Decide qué módulo atiende el mensaje y le pasa la configuración.\n// modulo: tareas | habitos | agenda | nota | ayuda | error\n// ---------------------------------------------------------------\nconst config = $('Configuración').first().json;\nconst mensaje = $('Telegram Trigger').first().json.message || {};\nconst chatId = String(mensaje.chat?.id || '');\nconst texto = String(mensaje.text || '').trim();\n\nconst AYUDA = [\n  'Personal Productivity Hub',\n  '',\n  'TAREAS: /nueva, /tareas, /estado, /hecha',\n  'HÁBITOS: /habito, /habitos, /hoy, /stats',\n  'AGENDA: /agenda - eventos y tareas de hoy',\n  'NOTAS IA: /nota texto - clasifica y resume una nota' + (config.aiEnabled ? '' : ' (desactivado)'),\n  '',\n  'Un texto sin comando crea una tarea rápida.',\n].join('\\n');\n\nconst RUTAS = {\n  '/nueva': 'tareas', '/tareas': 'tareas', '/estado': 'tareas', '/hecha': 'tareas',\n  '/habito': 'habitos', '/habitos': 'habitos', '/hoy': 'habitos', '/stats': 'habitos',\n  '/agenda': 'agenda',\n  '/nota': 'nota',\n  '/start': 'ayuda', '/ayuda': 'ayuda', '/help': 'ayuda',\n};\n\nconst salida = { chatId, texto, config: { ...config } };\ndelete salida.config.chatIdAutorizado;\n\n// 1. Seguridad: solo responde al chat autorizado (si está configurado).\nconst autorizado = String(config.chatIdAutorizado || '').trim();\nif (autorizado && !autorizado.startsWith('REEMPLAZAR') && autorizado !== chatId) {\n  return [{ json: { ...salida, modulo: 'error', respuesta: 'Este bot es privado.' } }];\n}\n\n// 2. Solo mensajes de texto.\nif (!texto) {\n  return [{ json: { ...salida, modulo: 'error', respuesta: 'Solo puedo procesar mensajes de texto.' } }];\n}\n\n// 3. Enrutado por comando.\nconst primera = texto.split(/\\s+/)[0];\nconst comando = primera.startsWith('/') ? primera.toLowerCase().split('@')[0] : null;\nconst argumentos = comando ? texto.slice(primera.length).trim() : texto;\nconst modulo = comando === null ? 'tareas' : RUTAS[comando];\n\nif (!modulo) return [{ json: { ...salida, modulo: 'error', respuesta: `Comando no reconocido: ${comando}\\n\\n${AYUDA}` } }];\nif (modulo === 'ayuda') return [{ json: { ...salida, modulo, respuesta: AYUDA } }];\nif (modulo === 'nota' && !config.aiEnabled) {\n  return [{ json: { ...salida, modulo: 'error', respuesta: 'Las notas con IA están desactivadas. Actívalas con aiEnabled = true en la Configuración del router.' } }];\n}\nreturn [{ json: { ...salida, modulo, comando, argumentos } }];"
      },
