    {
      "parameters": {
        "jsCode": "// Construye un aviso breve sin incluir datos personales de la ejecución.\nconst e = $input.first().json;\nconst lineas = [\n  'Error en el Productivity Hub',\n  `Workflow: ${e.workflow?.name || 'desconocido'}`,\n  `Nodo: ${e.execution?.lastNodeExecuted || 'desconocido'}`,\n  `Mensaje: ${String(e.execution?.error?.message || 'sin mensaje').slice(0, 300)}`,\n  `Hora: ${$now.toFormat('yyyy-MM-dd HH:mm')}`,\n];\nif (e.execution?.url) lineas.push(`Detalle: ${e.execution.url}`);\nreturn [{ json: { chatId: e.chatId, respuesta: lineas.join('\\n') } }];"
      },
      "id": "397741b2-2a1f-54b6-ac58-1e874124d123",
      "name": "Formatear aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.respuesta }}",
