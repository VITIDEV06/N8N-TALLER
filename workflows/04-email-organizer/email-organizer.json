    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Clasifica cada correo mediante reglas explicables (sin IA).\n// Categorías: importante | tarea | notificacion | newsletter | otros\n// Funciona con la salida simplificada del Gmail Trigger\n// (campos From, Subject, snippet, id).\n// ---------------------------------------------------------------\nconst normalizar = (t) => String(t || '')\n  .normalize('NFD').replace(/[̀-ͯ]/g, '')\n  .toLowerCase();\n\nconst config = $('Configuración').first().json;\nconst remitentesImportantes = String(config.remitentesImportantes || '')\n  .split(',').map((r) => normalizar(r).trim()).filter(Boolean);\n\nconst REGLAS = {\n  newsletter: ['newsletter', 'boletin', 'darte de baja', 'darse de baja', 'unsubscribe', 'cancelar suscripcion', 'resumen semanal', 'digest'],\n  notificacionRemitente: ['no-reply', 'noreply', 'no_reply', 'notifications', 'notificaciones', 'alerts', 'alertas', 'mailer-daemon'],\n  notificacionAsunto: ['notificacion', 'alerta', 'confirmacion', 'tu pedido', 'recibo', 'inicio de sesion', 'codigo de verificacion', 'verification code', 'password reset'],\n  importante: ['urgente', 'importante', 'asap', 'fecha limite', 'vence hoy', 'vencimiento', 'accion requerida', 'action required'],\n  tarea: ['por favor', 'podrias', 'puedes', 'necesito que', 'pendiente', 'revisar', 'revision', 'enviar antes', 'to do', 'tarea', 'solicitud'],\n};\n\nconst contiene = (texto, palabras) => palabras.find((p) => texto.includes(p));\n\nfunction extraerDireccion(remitente) {\n  const coincidencia = String(remitente || '').match(/<([^>]+)>/);\n  return normalizar(coincidencia ? coincidencia[1] : remitente).trim();\n}\n\nfunction clasificar(correo) {\n  const remitente = correo.From || correo.from?.text || correo.from || '';\n  const direccion = extraerDireccion(remitente);\n  const asunto = correo.Subject || correo.subject || '';\n  const texto = normalizar(`${asunto} ${correo.snippet || correo.text || ''}`);\n\n  let categoria = 'otros';\n  let motivo = 'No coincide con ninguna regla';\n  let palabra;\n\n  if (remitentesImportantes.some((r) => direccion.includes(r))) {\n    categoria = 'importante'; motivo = 'Remitente marcado como importante';\n  } else if ((palabra = contiene(texto, REGLAS.newsletter))) {\n    categoria = 'newsletter'; motivo = `Contiene \"${palabra}\"`;\n  } else if ((palabra = contiene(direccion, REGLAS.notificacionRemitente))) {\n    categoria = 'notificacion'; motivo = `Remitente automático (${palabra})`;\n  } else if ((palabra = contiene(texto, REGLAS.importante))) {\n    categoria = 'importante'; motivo = `Contiene \"${palabra}\"`;\n  } else if ((palabra = contiene(texto, REGLAS.notificacionAsunto))) {\n    categoria = 'notificacion'; motivo = `Contiene \"${palabra}\"`;\n  } else if ((palabra = contiene(texto, REGLAS.tarea))) {\n    categoria = 'tarea'; motivo = `Contiene \"${palabra}\"`;\n  }\n\n  return {\n    message_id: correo.id || '',\n    fecha_procesado: $now.toFormat('yyyy-MM-dd HH:mm'),\n    remitente: direccion,\n    asunto: String(asunto).slice(0, 200),\n    categoria,\n    motivo,\n  };\n}\n\nreturn $input.all()\n  .filter((item) => item.json && (item.json.id || item.json.Subject || item.json.subject))\n  .map((item) => ({ json: clasificar(item.json) }));"
      },
