# =================================================================
# Variante de .env para usar un TÚNEL HTTPS (Telegram Trigger)
# -----------------------------------------------------------------
# Copia solo las líneas que cambian respecto a .env.example en tu .env.
# Después ejecuta: docker compose up -d
# Ver guides/telegram-setup.md
# =================================================================

# URL pública del túnel, con "/" final (cambia cada vez que reinicias
# un túnel rápido de Cloudflare)
WEBHOOK_URL=https://tu-subdominio.trycloudflare.com/

# Hay un proxy (el túnel) delante de n8n
N8N_PROXY_HOPS=1
