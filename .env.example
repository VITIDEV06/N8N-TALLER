# =================================================================
# n8n Productivity Workshop - Variables de entorno de ejemplo
# -----------------------------------------------------------------
# 1. Copia este archivo:      cp .env.example .env
# 2. Cambia TODOS los valores marcados con CAMBIAR.
# 3. Nunca subas el archivo .env a GitHub (ya esta en .gitignore).
# =================================================================

# -----------------------------------------------------------------
# Version de n8n
# Version con la que se desarrollo y valido el taller.
# Fija siempre una version concreta; evita "latest" en tus entornos.
# -----------------------------------------------------------------
N8N_VERSION=2.48.4

# -----------------------------------------------------------------
# Red y URL publica
# En local deja estos valores. Si usas un tunel HTTPS (por ejemplo
# para Telegram), cambia WEBHOOK_URL por la URL del tunel con "/" final.
# -----------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Numero de proxies inversos delante de n8n (0 en local, 1 con tunel o proxy)
N8N_PROXY_HOPS=0

# -----------------------------------------------------------------
# Zona horaria (afecta a Schedule Trigger y a las fechas)
# Lista de valores: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# -----------------------------------------------------------------
GENERIC_TIMEZONE=America/Mexico_City
TZ=America/Mexico_City

# -----------------------------------------------------------------
# Clave de cifrado de credenciales
# n8n cifra las credenciales guardadas con esta clave.
# Genera una con:  openssl rand -hex 32
# Si la pierdes, NO podras descifrar las credenciales existentes.
# -----------------------------------------------------------------
N8N_ENCRYPTION_KEY=CAMBIAR_genera_una_clave_aleatoria_de_64_caracteres

# -----------------------------------------------------------------
# Base de datos PostgreSQL
# -----------------------------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CAMBIAR_contrasena_segura_para_postgres

# -----------------------------------------------------------------
# Privacidad y mantenimiento
# -----------------------------------------------------------------
# Desactiva el envio de telemetria anonima a n8n
N8N_DIAGNOSTICS_ENABLED=false
# Borra ejecuciones antiguas automaticamente (en horas: 336 = 14 dias)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
